# Static Astro output for Hostinger Apache/LiteSpeed shared hosting.
Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Keep old CV links useful. The current uploaded CV is served as a real file.
Redirect 301 /mahmoud-fawzy-cv.pdf /assets/mahmoud-fawzy%20c.v.pdf
Redirect 301 /wp-content/uploads/2025/03/mahmoud-fawzy-c.v.pdf /assets/mahmoud-fawzy%20c.v.pdf

# No SPA rewrite: real directories serve their index.html; unknown paths stay 404.
<IfModule mod_mime.c>
  AddType application/pdf .pdf
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType image/png .png
  AddType text/javascript .js
  AddType text/css .css
  AddType font/woff .woff
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Revalidate replaceable files, including HTML, images and the current CV.
  Header set Cache-Control "no-cache"
</IfModule>

# X-XSS-Protection is obsolete and deliberately omitted.
# Content-hashed assets override caching only within /_astro/.htaccess.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
