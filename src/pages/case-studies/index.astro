---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import { caseStudies } from '../../data/caseStudies';
---
<BaseLayout title="Development Case Studies | Mahmoud Fawzy" description="How Mahmoud Fawzy built Happylife Tourism, worked on UPC Realty and designed a resumable n8n workflow. Architecture, contribution and implementation details.">
  <section class="page-hero container"><p class="eyebrow">Selected work</p><h1>My <span class="accent">Case Studies</span></h1><p class="page-intro">The requirements, technical decisions and delivery behind two websites and a business automation workflow.</p></section>
  <section class="section" aria-labelledby="case-list-heading"><h2 id="case-list-heading" class="sr-only">Selected case studies</h2><div class="container case-grid">{caseStudies.map((study, index) => <CaseStudyCard study={study} index={index} />)}</div></section>
</BaseLayout>
