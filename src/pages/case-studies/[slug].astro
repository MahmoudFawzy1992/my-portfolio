---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { caseStudies } from '../../data/caseStudies';
import { profile } from '../../data/profile';
export function getStaticPaths() { return caseStudies.map(study => ({ params: { slug: study.slug }, props: { study } })); }
const { study } = Astro.props;
const image = 'image' in study ? study.image : undefined;
const liveUrl = 'url' in study ? study.url : undefined;
const otherStudies = caseStudies.filter(item => item.slug !== study.slug);
const schema = { '@type': 'Article', headline: `${study.title} — development case study`, description: study.summary, author: { '@id': 'https://mahmoud-fawzy.com/#person' }, mainEntityOfPage: `https://mahmoud-fawzy.com/case-studies/${study.slug}/`, ...(image ? { image: `https://mahmoud-fawzy.com${image}` } : {}) };
---
<BaseLayout title={`${study.title} Case Study | Mahmoud Fawzy`} description={study.summary} schema={schema}>
  <article class="case-study">
    <header class="case-hero container"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/case-studies/">Case studies</a><span aria-hidden="true">/</span><span>{study.title}</span></nav><p class="eyebrow">{study.category}</p><h1>{study.title}<span class="accent">.</span></h1><p class="case-tagline">{study.tagline}</p><div class="chips">{study.technologies.map(technology => <span>{technology}</span>)}</div><div class="case-actions">{liveUrl && <a class="button button-primary" href={liveUrl} target="_blank" rel="noopener noreferrer">Visit live website ↗</a>}<a class="button button-secondary" href="#implementation">Explore implementation ↓</a></div></header>
    <div class="container"><div class="case-facts">{study.facts.map(fact => <div><strong>{fact.value}</strong><span>{fact.label}</span></div>)}</div>
      {image ? <figure class="case-screen"><div class="browser-chrome"><span></span><span></span><span></span><small>{study.title}</small></div><div class="case-screen-scroll" tabindex="0" role="region" aria-label={`${study.title} homepage preview; scroll to explore`}><img src={image} alt={`${study.title} homepage`} width={'imageWidth' in study ? study.imageWidth : undefined} height={'imageHeight' in study ? study.imageHeight : undefined} loading="eager" /></div><figcaption>{study.title} — homepage preview</figcaption></figure> : <div class="automation-hero surface"><p class="eyebrow">Workflow architecture</p><div class="workflow-big"><div><span>01</span><strong>Orchestrate</strong><p>Validate · budget · restore state</p></div><span class="flow-arrow" aria-hidden="true">→</span><div><span>02</span><strong>Acquire & audit</strong><p>APIs · bounded polling · rate control</p></div><span class="flow-arrow" aria-hidden="true">→</span><div><span>03</span><strong>Verify & persist</strong><p>Review queue · checkpoint · resume</p></div></div><p class="diagram-caption">Simplified workflow. Private data is omitted.</p></div>}
    </div>
    <div class="container case-body"><aside class="case-sidebar"><p class="eyebrow">In this case study</p><nav aria-label="Case-study sections"><a href="#context">Project & contribution</a><a href="#functionality">Key features</a><a href="#implementation">Technical decisions</a><a href="#result">Result</a><a href="#evidence">Scope & review</a></nav><div class="sidebar-role"><small>My role</small><p>{study.role}</p></div></aside><div class="case-content">
      <section id="context" aria-labelledby="context-heading"><p class="eyebrow">01 / Context</p><h2 id="context-heading">The project and my contribution</h2><p>{study.context}</p><div class="contribution surface"><span class="accent">My contribution</span><p>{study.roleDetail}</p></div></section>
      <section id="functionality" aria-labelledby="functionality-heading"><p class="eyebrow">02 / Functionality</p><h2 id="functionality-heading">Key Features</h2><div class="feature-grid">{study.features.map((feature, index) => <article class="feature-card"><span class="feature-index">0{index + 1}</span><h3>{feature.title}</h3><p>{feature.text}</p></article>)}</div></section>
      <section id="implementation" aria-labelledby="implementation-heading"><p class="eyebrow">03 / Implementation</p><h2 id="implementation-heading">Technical decisions</h2><figure class="architecture-map"><ol>{study.flow.map((stage, index) => <li><span>0{index + 1}</span><strong>{stage}</strong></li>)}</ol><figcaption>Simplified architecture</figcaption></figure><div class="decisions">{study.decisions.map(decision => <article><h3>{decision.title}</h3><p>{decision.text}</p></article>)}</div></section>
      <section id="result" class="result-section surface" aria-labelledby="result-heading"><p class="eyebrow">04 / Delivery</p><h2 id="result-heading">Result</h2><p>{study.outcome}</p></section>
      <section id="evidence" class="evidence-section" aria-labelledby="evidence-heading"><p class="eyebrow">05 / Evidence</p><h2 id="evidence-heading">Scope & Review</h2><p>{study.evidence}</p>{study.sources.length > 0 && <ul class="source-links">{study.sources.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} ↗</a></li>)}</ul>}</section>
    </div></div>
    <section class="case-next section"><div class="container"><p class="eyebrow">Keep exploring</p><h2>More Case Studies</h2><div class="next-grid">{otherStudies.map(other => <a class="surface" href={`/case-studies/${other.slug}/`}><span>{other.category}</span><strong>{other.title} ↗</strong></a>)}</div><a class="text-link" href={profile.cv} download="Mahmoud-Fawzy-CV.pdf">Download my CV ↓</a></div></section>
  </article>
</BaseLayout>
