---
import type { caseStudies } from '../data/caseStudies';
import { responsiveImage } from '../lib/images';
interface Props { study: (typeof caseStudies)[number]; index?: number; }
const { study, index = 0 } = Astro.props;
const image = 'image' in study ? study.image : undefined;
const preview = image ? await responsiveImage(image, 800) : undefined;
---
<article class:list={['case-card', { 'case-card-automation': !image }]} data-reveal>
  <a href={`/case-studies/${study.slug}/`} class="case-card-visual" aria-label={`Read the ${study.title} case study`}>
    {preview ? <div class="browser-frame"><div class="browser-chrome"><span></span><span></span><span></span><small>{study.title}</small></div><img {...preview} sizes="(max-width: 767px) 90vw, 45vw" alt={`${study.title} website homepage`} loading="lazy" /></div> : <div class="workflow-preview" aria-hidden="true"><span class="workflow-line"></span><div>n8n<span>Orchestrate</span></div><div>API<span>Acquire</span></div><div>↻<span>Verify & resume</span></div><p>CONTROLLED EXECUTION / DURABLE STATE</p></div>}
  </a>
  <div class="case-card-body"><p class="eyebrow"><span class="case-number">0{index + 1}</span> {study.category}</p><h3><a href={`/case-studies/${study.slug}/`}>{study.title}</a></h3><p>{study.summary}</p><div class="chips">{study.technologies.slice(0, 4).map(tech => <span>{tech}</span>)}</div><a class="text-link" href={`/case-studies/${study.slug}/`}>Explore case study <span aria-hidden="true">↗</span></a></div>
</article>
