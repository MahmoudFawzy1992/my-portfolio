---
import { profile } from '../data/profile';
import SocialLinks from './SocialLinks.astro';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
interface Props { heading?: boolean; }
const { heading = true } = Astro.props;
const ProfileHeading = heading ? 'h3' : 'h2';
---
<section class="section contact-section" id="contact" aria-labelledby={heading ? 'contact-heading' : 'contact-page-heading'}>
  <div class="container">
    {heading && <SectionHeading eyebrow="Get in touch" title="Contact Me" id="contact-heading" description="Get in touch about a developer role, collaboration or freelance project." />}
    <div class="contact-layout">
      <aside class="contact-info surface" data-reveal><div class="contact-photo-frame"><img class="contact-photo" src="/assets/images/optimized/contact-me-480.webp" alt="Mahmoud Fawzy" width="480" height="313" loading="lazy" /></div><ProfileHeading>{profile.name}</ProfileHeading><p>{profile.role}</p><p class="contact-location">Based in {profile.location}. Open to developer opportunities and relevant freelance projects.</p><div class="contact-links"><a href={`tel:${profile.phone}`}><small>Phone</small>{profile.phoneLabel}</a><a href={`mailto:${profile.email}`}><small>Email</small>{profile.email}</a></div><p class="hero-footer-title">Find me in</p><SocialLinks /><a class="text-link" href={profile.cv} download="Mahmoud-Fawzy-CV.pdf">Download my CV ↓</a></aside>
      <div class="contact-details surface" data-reveal>
        <ProfileHeading>Let’s connect</ProfileHeading>
        <p>Get in touch about a developer role, collaboration or project.</p>
        <div class="contact-email"><p class="hero-footer-title">Email</p><a class="email-address" href={`mailto:${profile.email}`}>{profile.email}</a></div>
        <a class="button button-primary" href={`mailto:${profile.email}`}>Send me an email <Icon name="arrow" /></a>
        <div class="contact-profile-links"><a href={profile.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" /><span>Connect on LinkedIn</span><span class="sr-only"> (opens in a new tab)</span><Icon name="arrow" /></a><a href={profile.github} target="_blank" rel="noopener noreferrer"><Icon name="github" /><span>Explore my GitHub</span><span class="sr-only"> (opens in a new tab)</span><Icon name="arrow" /></a></div>
        <p class="contact-location">Based in {profile.location}.</p>
      </div>
    </div>
  </div>
</section>
