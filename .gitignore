# ================================
# Mahmoud Fawzy Portfolio — .gitignore
# ================================

# ─── Dependencies ───────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ─── Build outputs ──────────────
dist/
dist-ssr/
build/
out/

# ─── Environment / Secrets ──────
.env
.env.local
.env.*.local
.env.production

# ─── Vite cache ─────────────────
.vite/
vite.config.js.timestamp-*

# ─── Editor & IDE ───────────────
.vscode/
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
.vim/
nbproject/

# ─── OS generated ───────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Logs ───────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Coverage & testing ─────────
coverage/
*.lcov
.nyc_output/

# ─── TypeScript ─────────────────
*.tsbuildinfo

# ─── Misc ───────────────────────
*.local
.cache/
*.tmp
*.temp

.astro/
tmp/
output/
public/assets/images/optimized/
public/assets/images/social-card.png
