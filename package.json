{
  "name": "mahmoud-fawzy-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && astro dev",
    "build": "node scripts/prepare-assets.mjs && astro build",
    "preview": "node scripts/static-server.mjs",
    "lint": "eslint . --max-warnings 0",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "verify:static": "node scripts/verify-static.mjs",
    "verify:http": "node scripts/verify-http.mjs",
    "measure": "node scripts/measure-build.mjs",
    "package:hostinger": "npm run build && node scripts/package-hostinger.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/poppins": "^5.2.7",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^9.39.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.39.0",
    "eslint-plugin-astro": "^1.5.0",
    "fflate": "^0.8.2",
    "globals": "^16.4.0",
    "linkedom": "^0.18.12",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  }
}
